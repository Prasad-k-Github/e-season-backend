# Copy to .env and edit. Never commit .env.
PORT=3000
NODE_ENV=development

# MySQL 8.0.16+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=e_season

# Long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-jwt-secret
NIC_PEPPER=change-me-nic-pepper

# ---- Phone OTP ----
# mock: no SMS is sent; the code is returned in the API response (development only, never in production)
# textlk | notifylk: send a real SMS
OTP_PROVIDER=mock
OTP_TTL_MINUTES=5
#TEXTLK_API_TOKEN=
#TEXTLK_SENDER_ID=
#NOTIFYLK_USER_ID=
#NOTIFYLK_API_KEY=
#NOTIFYLK_SENDER_ID=

# ---- E-mail verification ----
# mock: no e-mail is sent; the code is printed in the server log and returned in the API response
#       (development only. The server refuses to send e-mail codes in production with mock)
# smtp: send real e-mail through the SMTP settings below
EMAIL_PROVIDER=mock
EMAIL_FROM="E-Season <no-reply@example.com>"
EMAIL_CODE_TTL_MINUTES=10
# false: the e-mail stays optional and unverified unless the app sends an emailToken (works with the
#        current Flutter app). Set to true once the app has the e-mail verification step: then
#        POST /api/register refuses a missing or unverified e-mail.
REQUIRE_EMAIL_VERIFICATION=false

# Gmail example (needs 2-step verification and an App Password: https://myaccount.google.com/apppasswords)
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=youraddress@gmail.com
#SMTP_PASS=your-16-character-app-password

# ---- Other ----
TICKET_PRIVATE_KEY_PATH=./keys/ticket_private.pem
TICKET_PUBLIC_KEY_PATH=./keys/ticket_public.pem
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# true: applications are only accepted inside an application_windows row
ENFORCE_APPLICATION_WINDOWS=false
# Optional: comma-separated web origins (admin web). Empty = allow all (development only)
#CORS_ORIGIN=
# Set to 1 behind a reverse proxy so rate limits see real client IPs
#TRUST_PROXY=

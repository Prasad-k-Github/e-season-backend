{
  "name": "e_season API",
  "baseUrl": "http://localhost:3000",
  "prefix": "/api",
  "auth": {
    "scheme": "Authorization: Bearer <token>",
    "tokens": {
      "registrationToken": "from POST /auth/otp/verify when phone is new; only valid for POST /register",
      "userToken": "from POST /auth/login, verify (existing account) or /register; for passenger endpoints",
      "staffToken": "from POST /auth/staff/login; roles: station_staff | institution_officer | admin"
    }
  },
  "errorFormat": {
    "error": {
      "code": "string",
      "message": "string",
      "details": "optional (validation errors)"
    }
  },
  "commonStatus": {
    "400": "validation / bad input",
    "401": "missing or invalid token",
    "402": "sandbox payment declined",
    "403": "wrong role or not verified",
    "404": "not found",
    "409": "conflict (overlap, already paid, wrong status)",
    "429": "rate limited / OTP cooldown or locked"
  },
  "enums": {
    "passengerType": [
      "government",
      "private",
      "general (alias of private, register only)"
    ],
    "ticketClass": [
      "first",
      "second",
      "third"
    ],
    "period": [
      "weekly",
      "monthly",
      "quarterly"
    ],
    "preferredLanguage": [
      "en",
      "si",
      "ta"
    ],
    "verificationStatus": [
      "pending_institution_approval",
      "pending_verification",
      "verified",
      "rejected"
    ],
    "applicationStatus": [
      "pending_institution_approval",
      "approved_awaiting_payment",
      "paid",
      "rejected",
      "cancelled"
    ],
    "ticketStatus": [
      "active",
      "expired",
      "revoked"
    ],
    "scanResult": [
      "valid",
      "expired",
      "revoked",
      "invalid"
    ],
    "decision": [
      "approved",
      "rejected (reason required, min 3 chars)"
    ],
    "documentType": [
      "photo",
      "nic_front",
      "nic_back"
    ],
    "staffRole": [
      "station_staff",
      "institution_officer",
      "admin"
    ]
  },
  "validation": {
    "phone": "Sri Lankan mobile, 07XXXXXXXX",
    "otpCode": "6 digits",
    "nic": "9 digits + V/X, or 12 digits",
    "dates": "YYYY-MM-DD",
    "files": "JPEG/PNG, max 5 MB each",
    "governmentDurationMonths": "1 to 3"
  },
  "flow": [
    "Returning passenger: POST /auth/login {phone, password} -> token",
    "POST /auth/otp/request -> devCode (non-production only)",
    "POST /auth/otp/verify -> token (existing) or registrationToken (new)",
    "POST /register (multipart) -> token + verificationStatus",
    "Staff approve (institution-decision for government, then verification-decision)",
    "POST /fares/quote -> POST /applications",
    "Government: officer POST /staff/applications/:id/decision",
    "POST /applications/:id/pay -> ticket with qrToken",
    "Inspector: POST /staff/tickets/scan {token}"
  ],
  "endpoints": [
    {
      "group": "Public",
      "method": "GET",
      "path": "/health",
      "auth": null,
      "response": {
        "200": {
          "status": "ok"
        }
      }
    },
    {
      "group": "Public",
      "method": "GET",
      "path": "/stations",
      "auth": null,
      "response": {
        "200": [
          {
            "id": "string",
            "name": "string",
            "line": "string",
            "hasSeatReservation": true
          }
        ]
      }
    },
    {
      "group": "Public",
      "method": "GET",
      "path": "/institutions",
      "auth": null,
      "response": {
        "200": [
          {
            "id": "string",
            "name": "string"
          }
        ]
      }
    },
    {
      "group": "Public",
      "method": "GET",
      "path": "/ticket-public-key",
      "auth": null,
      "response": {
        "200": "text/plain PEM public key (verify ES256 tickets offline)"
      }
    },
    {
      "group": "Auth",
      "method": "POST",
      "path": "/auth/otp/request",
      "auth": null,
      "contentType": "application/json",
      "body": {
        "phone": "0771234567"
      },
      "response": {
        "200": {
          "expiresInSeconds": 300,
          "devCode": "123456 (non-production only)"
        }
      },
      "errors": [
        "400 bad_phone",
        "429 otp_cooldown"
      ]
    },
    {
      "group": "Auth",
      "method": "POST",
      "path": "/auth/otp/verify",
      "auth": null,
      "contentType": "application/json",
      "body": {
        "phone": "0771234567",
        "code": "123456"
      },
      "response": {
        "200 existing account": {
          "registered": true,
          "token": "string",
          "verificationStatus": "string"
        },
        "200 new number": {
          "registered": false,
          "registrationToken": "string"
        }
      },
      "errors": [
        "400 bad_code | otp_missing | otp_expired | otp_incorrect",
        "429 otp_locked"
      ]
    },
    {
      "group": "Auth",
      "method": "POST",
      "path": "/auth/login",
      "auth": null,
      "contentType": "application/json",
      "body": {
        "phone": "0771234567",
        "password": "string"
      },
      "response": {
        "200": {
          "token": "userToken",
          "verificationStatus": "string"
        }
      },
      "errors": [
        "401 unauthorized (same message for wrong phone or wrong password)",
        "429 rate limited"
      ],
      "note": "Passenger login. OTP verify still returns a token for existing accounts (use it for forgot-password / legacy accounts)."
    },
    {
      "group": "Auth",
      "method": "POST",
      "path": "/auth/staff/login",
      "auth": null,
      "contentType": "application/json",
      "body": {
        "email": "admin@eseason.test",
        "password": "ChangeMe#2026"
      },
      "response": {
        "200": {
          "token": "string",
          "staff": {
            "id": "string",
            "fullName": "string",
            "role": "staffRole"
          }
        }
      },
      "errors": [
        "401 unauthorized"
      ]
    },
    {
      "group": "Registration",
      "method": "POST",
      "path": "/register",
      "auth": "registrationToken",
      "contentType": "multipart/form-data",
      "fields": {
        "passengerType": "required: government | private | general",
        "fullName": "required, letters only, min 3",
        "nic": "required",
        "password": "required, 8-128 characters",
        "address": "required",
        "email": "optional",
        "dateOfBirth": "optional YYYY-MM-DD",
        "preferredLanguage": "optional en | si | ta",
        "consent": "required, must be 'true'",
        "photo": "required file (alias profilePhoto)",
        "nicFront": "required file",
        "nicBack": "required file",
        "institutionId": "government only (or institution = name)",
        "orgAuthCode": "government only, secret code from the institution",
        "employeeNo": "government only, optional",
        "designation": "government only, optional",
        "employerName": "private only, optional"
      },
      "response": {
        "201": {
          "userId": "string",
          "referenceNumber": "ES-XXXXXXXX",
          "verificationStatus": "verificationStatus",
          "token": "userToken"
        }
      },
      "errors": [
        "400 phone_mismatch | missing_document | validation",
        "409 duplicate NIC/phone"
      ]
    },
    {
      "group": "Passenger",
      "method": "GET",
      "path": "/me",
      "auth": "userToken",
      "response": {
        "200": {
          "id": "string",
          "passengerType": "string",
          "fullName": "string",
          "phone": "string",
          "email": "string|null",
          "nicLast4": "string",
          "address": "string",
          "preferredLanguage": "string",
          "verificationStatus": "string",
          "rejectionReason": "string|null",
          "createdAt": "datetime"
        }
      }
    },
    {
      "group": "Passenger",
      "method": "PUT",
      "path": "/me/password",
      "auth": "userToken",
      "contentType": "application/json",
      "body": {
        "currentPassword": "string",
        "newPassword": "min 8"
      },
      "response": {
        "200": {
          "changed": true
        }
      },
      "errors": [
        "400 wrong_password | validation"
      ],
      "note": "Legacy accounts with no password may send any currentPassword."
    },
    {
      "group": "Passenger",
      "method": "DELETE",
      "path": "/me",
      "auth": "userToken",
      "response": {
        "204": "no body; account anonymised, tickets revoked"
      }
    },
    {
      "group": "Passenger",
      "method": "POST",
      "path": "/me/resubmit",
      "auth": "userToken",
      "contentType": "multipart/form-data",
      "fields": {
        "photo": "file",
        "nicFront": "file",
        "nicBack": "file"
      },
      "response": {
        "200": {
          "verificationStatus": "string"
        }
      }
    },
    {
      "group": "Passenger",
      "method": "POST",
      "path": "/fares/quote",
      "auth": "userToken",
      "contentType": "application/json",
      "body": {
        "fromStationId": "string",
        "toStationId": "string",
        "ticketClass": "third",
        "period": "monthly",
        "durationMonths": 1
      },
      "response": {
        "200": {
          "fareLkr": 1500,
          "durationMonths": 1
        }
      },
      "errors": [
        "404 no_fare"
      ]
    },
    {
      "group": "Passenger",
      "method": "POST",
      "path": "/applications",
      "auth": "userToken",
      "contentType": "application/json",
      "body": {
        "fromStationId": "string",
        "toStationId": "string",
        "ticketClass": "third",
        "period": "monthly",
        "startDate": "2026-11-01",
        "durationMonths": 1
      },
      "response": {
        "201": "Application"
      },
      "errors": [
        "403 not_verified",
        "404 no_fare",
        "409 overlap"
      ]
    },
    {
      "group": "Passenger",
      "method": "GET",
      "path": "/applications",
      "auth": "userToken",
      "response": {
        "200": [
          "Application"
        ]
      }
    },
    {
      "group": "Passenger",
      "method": "GET",
      "path": "/applications/:id",
      "auth": "userToken",
      "response": {
        "200": "Application"
      }
    },
    {
      "group": "Passenger",
      "method": "POST",
      "path": "/applications/:id/cancel",
      "auth": "userToken",
      "response": {
        "200": {
          "status": "cancelled"
        }
      }
    },
    {
      "group": "Passenger",
      "method": "POST",
      "path": "/applications/:id/pay",
      "auth": "userToken",
      "contentType": "application/json",
      "body": {
        "simulate": "success | fail (optional, non-production only)"
      },
      "response": {
        "201 paid": {
          "paid": true,
          "paymentId": "string",
          "ticket": "Ticket (with qrToken)"
        },
        "402 declined": {
          "paid": false,
          "paymentId": "string",
          "message": "string"
        }
      },
      "errors": [
        "403 not_verified",
        "409 already_paid | wrong_status"
      ]
    },
    {
      "group": "Passenger",
      "method": "GET",
      "path": "/tickets",
      "auth": "userToken",
      "response": {
        "200": [
          "Ticket (with qrToken)"
        ]
      }
    },
    {
      "group": "Passenger",
      "method": "GET",
      "path": "/tickets/:id",
      "auth": "userToken",
      "response": {
        "200": "Ticket (with qrToken)"
      }
    },
    {
      "group": "Staff",
      "method": "GET",
      "path": "/staff/users/pending",
      "auth": "staffToken (any role)",
      "response": {
        "200": [
          "StaffUser"
        ]
      }
    },
    {
      "group": "Staff",
      "method": "GET",
      "path": "/staff/users/:id",
      "auth": "staffToken (any role; officer only own institution)",
      "response": {
        "200": {
          "...StaffUser": "",
          "documents": [
            {
              "type": "documentType",
              "uploadedAt": "datetime",
              "url": "/api/staff/users/:id/docs/:type"
            }
          ]
        }
      }
    },
    {
      "group": "Staff",
      "method": "GET",
      "path": "/staff/users/:id/docs/:type",
      "auth": "staffToken (any role)",
      "response": {
        "200": "image binary. Needs the Authorization header, so fetch as blob instead of using <img src>"
      }
    },
    {
      "group": "Staff",
      "method": "POST",
      "path": "/staff/users/:id/institution-decision",
      "auth": "institution_officer",
      "contentType": "application/json",
      "body": {
        "decision": "approved | rejected",
        "reason": "required when rejected"
      },
      "response": {
        "200": {
          "status": "pending_verification | rejected"
        }
      }
    },
    {
      "group": "Staff",
      "method": "POST",
      "path": "/staff/users/:id/verification-decision",
      "auth": "station_staff",
      "contentType": "application/json",
      "body": {
        "decision": "approved | rejected",
        "reason": "required when rejected"
      },
      "response": {
        "200": {
          "status": "verified | rejected"
        }
      }
    },
    {
      "group": "Staff",
      "method": "GET",
      "path": "/staff/applications/pending",
      "auth": "institution_officer",
      "response": {
        "200": [
          "Application (with holderName)"
        ]
      }
    },
    {
      "group": "Staff",
      "method": "POST",
      "path": "/staff/applications/:id/decision",
      "auth": "institution_officer",
      "contentType": "application/json",
      "body": {
        "decision": "approved | rejected",
        "reason": "required when rejected"
      },
      "response": {
        "200": {
          "status": "approved_awaiting_payment | rejected"
        }
      }
    },
    {
      "group": "Staff",
      "method": "POST",
      "path": "/staff/tickets/scan",
      "auth": "station_staff | admin",
      "contentType": "application/json",
      "body": {
        "token": "qrToken string"
      },
      "response": {
        "200": {
          "result": "scanResult",
          "holder": {
            "name": "string",
            "photoUrl": "/api/staff/users/:id/docs/photo"
          },
          "fromStation": "string",
          "toStation": "string",
          "ticketClass": "string",
          "validFrom": "YYYY-MM-DD",
          "validTo": "YYYY-MM-DD",
          "message": "string"
        }
      },
      "note": "result 'invalid' for a forged token returns only { result, message }"
    },
    {
      "group": "Admin",
      "method": "GET",
      "path": "/admin/institutions",
      "auth": "admin",
      "response": {
        "200": [
          {
            "id": "string",
            "name": "string",
            "orgAuthCode": "string",
            "isActive": true
          }
        ]
      }
    },
    {
      "group": "Admin",
      "method": "POST",
      "path": "/admin/institutions",
      "auth": "admin",
      "contentType": "application/json",
      "body": {
        "name": "Ministry of Transport"
      },
      "response": {
        "201": {
          "id": "string",
          "name": "string",
          "orgAuthCode": "string"
        }
      }
    },
    {
      "group": "Admin",
      "method": "GET",
      "path": "/admin/staff",
      "auth": "admin",
      "response": {
        "200": [
          "staff user list"
        ]
      }
    },
    {
      "group": "Admin",
      "method": "POST",
      "path": "/admin/staff",
      "auth": "admin",
      "contentType": "application/json",
      "body": {
        "fullName": "string",
        "email": "string",
        "password": "min 8",
        "role": "staffRole",
        "stationId": "optional",
        "institutionId": "optional (officers)"
      },
      "response": {
        "201": {
          "id": "string",
          "email": "string",
          "role": "string"
        }
      }
    },
    {
      "group": "Admin",
      "method": "POST",
      "path": "/admin/stations",
      "auth": "admin",
      "contentType": "application/json",
      "body": {
        "name": "string",
        "line": "optional",
        "hasSeatReservation": false
      },
      "response": {
        "201": {
          "id": "string",
          "name": "string"
        }
      }
    },
    {
      "group": "Admin",
      "method": "POST",
      "path": "/admin/fares",
      "auth": "admin",
      "contentType": "application/json",
      "body": {
        "fromStationId": "string",
        "toStationId": "string",
        "ticketClass": "third",
        "period": "monthly",
        "passengerType": "government | private | null (both)",
        "amountLkr": 1500,
        "effectiveFrom": "YYYY-MM-DD optional"
      },
      "response": {
        "201": {
          "id": "string"
        }
      }
    },
    {
      "group": "Admin",
      "method": "POST",
      "path": "/admin/application-windows",
      "auth": "admin",
      "contentType": "application/json",
      "body": {
        "monthFor": "2026-11-01 (first of month)",
        "opensOn": "YYYY-MM-DD",
        "closesOn": "YYYY-MM-DD"
      },
      "response": {
        "201": {
          "id": "string"
        }
      }
    },
    {
      "group": "Admin",
      "method": "GET",
      "path": "/admin/audit",
      "auth": "admin",
      "query": {
        "limit": "number, e.g. 50"
      },
      "response": {
        "200": [
          "audit log entries"
        ]
      }
    }
  ],
  "models": {
    "Application": {
      "id": "string",
      "fromStationId": "string",
      "toStationId": "string",
      "fromStation": "string",
      "toStation": "string",
      "ticketClass": "string",
      "period": "string",
      "durationMonths": "number|null",
      "startDate": "YYYY-MM-DD",
      "endDate": "YYYY-MM-DD",
      "fareLkr": "number",
      "status": "applicationStatus",
      "rejectionReason": "string|null",
      "createdAt": "datetime",
      "holderName": "string (officer list only)"
    },
    "Ticket": {
      "id": "string",
      "applicationId": "string",
      "fromStation": "string",
      "toStation": "string",
      "ticketClass": "string",
      "validFrom": "YYYY-MM-DD",
      "validTo": "YYYY-MM-DD",
      "status": "ticketStatus",
      "issuedAt": "datetime",
      "qrToken": "string (render as QR code)"
    },
    "StaffUser": {
      "id": "string",
      "fullName": "string",
      "passengerType": "string",
      "phone": "string",
      "nicLast4": "string",
      "verificationStatus": "string",
      "institution": "string|null"
    }
  }
}
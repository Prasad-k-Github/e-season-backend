{
  "name": "e-season-backend",
  "version": "1.0.0",
  "description": "REST API for the e_season Sri Lanka Railways season ticket prototype (mock data only)",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
